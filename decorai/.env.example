# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_SUBSCRIPTION_PRICE_ID=price_...

# One-time token packs (run: STRIPE_SECRET_KEY=sk_... node scripts/setup-stripe-prices.mjs)
STRIPE_PRICE_ID_PACK_10=price_...
STRIPE_PRICE_ID_PACK_20=price_...
STRIPE_PRICE_ID_PACK_50=price_...

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
# Free premium generations granted on first sign-in (0 = none)
FREE_TOKENS=0

# Pre-signup generations: how many designs a first-time visitor can generate
# before creating an account. Requires ANON_DEVICE_SECRET — without it the
# feature stays off, because an unsigned device id is trivially forged.
# Run sql/anonymous_generations.sql before enabling.
#   openssl rand -hex 32
ANON_FREE_GENERATIONS=1
ANON_DEVICE_SECRET=
# Backstop for "clear the cookie, get another free run". Keep it low, but not
# so low that an office behind one NAT locks everyone out.
ANON_MAX_PER_IP_PER_DAY=5
APP_URL=http://localhost:5173
ALLOWED_ORIGIN=http://localhost:5173
REPLICATE_API_KEY=

# Google Analytics 4 (public Measurement ID, e.g. G-XXXXXXXXXX). Leave empty to disable.
GA_MEASUREMENT_ID=

# Generated design history (subscription feature — requires Supabase Storage bucket)
SUPABASE_DESIGNS_BUCKET=generated-designs
MAX_SAVED_DESIGNS_SUBSCRIBER=200
DESIGN_SIGNED_URL_TTL_SEC=3600

# Daily cap on FREE generations per signed-in account (UTC day). Free models
# don't use tokens, but each run is a paid prediction — this bounds that spend.
# 0 disables. Run sql/free_generation_daily_cap.sql so the count is durable;
# without it the server falls back to a per-instance in-memory counter.
FREE_DAILY_GENERATION_LIMIT=30
FREE_DAILY_GENERATION_LIMIT_SUBSCRIBER=100

# Deadlines for outbound provider calls, in ms. LONG applies to image generation.
PROVIDER_TIMEOUT_MS=30000
PROVIDER_LONG_TIMEOUT_MS=180000

# One-tap sign-in buttons to show: comma-separated, any of google, apple.
# Leave empty until the provider is enabled in Supabase (Authentication →
# Providers) and this site's URL is in its redirect allow-list.
AUTH_OAUTH_PROVIDERS=

# Largest JSON request body accepted (images travel as base64).
JSON_BODY_LIMIT=20mb

# Optional: estimated dollars per run, by model, for the generation_events
# table (run sql/generation_events.sql). Check your provider invoices for real
# figures — nothing is assumed when this is unset.
# MODEL_COST_USD={"google/nano-banana":0.00,"proplabs/virtual-staging":0.00,"openai/gpt-image-2":0.00}
