# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_SUBSCRIPTION_PRICE_ID=price_...

# One-time token packs (run: STRIPE_SECRET_KEY=sk_... node scripts/setup-stripe-prices.mjs)
STRIPE_PRICE_ID_PACK_10=price_...
STRIPE_PRICE_ID_PACK_20=price_...
STRIPE_PRICE_ID_PACK_50=price_...

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
# Free premium generations granted on first sign-in (0 = none)
FREE_TOKENS=0
APP_URL=http://localhost:5173
ALLOWED_ORIGIN=http://localhost:5173
REPLICATE_API_KEY=

# Generated design history (subscription feature — requires Supabase Storage bucket)
SUPABASE_DESIGNS_BUCKET=generated-designs
MAX_SAVED_DESIGNS_SUBSCRIBER=200
DESIGN_SIGNED_URL_TTL_SEC=3600
