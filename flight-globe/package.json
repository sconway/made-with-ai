{
  "name": "flight-globe",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"npm run server\" \"npm run web\"",
    "dev:mock": "FLIGHT_BACKEND_MOCK=1 concurrently -k -n server,web -c cyan,magenta \"npm run server\" \"npm run web\"",
    "web": "vite",
    "server": "tsx watch --env-file=.env server/index.ts",
    "server:mock": "FLIGHT_BACKEND_MOCK=1 tsx watch --env-file=.env server/index.ts",
    "test:api": "tsx server/load-test.ts",
    "build": "tsc && vite build",
    "start": "tsx server/index.ts",
    "preview": "npm run build && tsx server/index.ts"
  },
  "dependencies": {
    "@react-three/drei": "9.114.0",
    "@react-three/fiber": "8.17.10",
    "earcut": "2.2.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.169.0",
    "tsx": "4.19.2",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@types/earcut": "2.1.4",
    "@types/node": "22.10.2",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.0",
    "@types/three": "0.169.0",
    "@vitejs/plugin-react": "4.3.2",
    "concurrently": "9.1.0",
    "typescript": "5.6.3",
    "vite": "5.4.9"
  }
}
