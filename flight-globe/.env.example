# ---------------------------------------------------------------------------
# Flight data source
# ---------------------------------------------------------------------------
# Default (unset): keyless airplanes.live — works with no account, tiles
# coverage across the view.
#
# Set to "opensky" for full bounding-box coverage of the whole visible area
# (recommended for the best look). Requires the OpenSky credentials below.
VITE_FLIGHT_SOURCE=opensky

# ---------------------------------------------------------------------------
# OpenSky authentication (needed when VITE_FLIGHT_SOURCE=opensky)
# ---------------------------------------------------------------------------
# Anonymous OpenSky is ~400 credits/day and returns "429 Too Many Requests"
# quickly. A FREE account gets 4,000/day.
#
# 1. Create a free account at https://opensky-network.org
# 2. Account -> create an API client (OAuth2 client credentials).
# 3. Paste the client id + secret below and restart `npm run dev`.
#
# Read ONLY by the Vite dev server (vite.config.ts); never sent to the browser.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
