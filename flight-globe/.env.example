# ---------------------------------------------------------------------------
# Shared flight backend (recommended for multi-user)
# ---------------------------------------------------------------------------
# `npm run dev`      → real OpenSky via the shared poller (same path as deploy)
# `npm run dev:mock` → synthetic traffic only (no OpenSky credits)
#
# Set to "0" to bypass the backend and hit OpenSky / airplanes.live directly
# through Vite proxies (local debugging only — will rate-limit with many users).
# VITE_USE_BACKEND=1

# Backend listen port (default 8787). Vite proxies /api → this port.
# On Render/Fly/Railway, the host sets PORT — that wins over this.
# FLIGHT_BACKEND_PORT=8787
# PORT=8787

# Upstream for the shared poller:
#   auto    — try OpenSky, fall back to adsb.lol if OpenSky is unreachable
#             (typical on Render/Fly/Railway — OpenSky may block cloud IPs)
#   opensky — OpenSky only
#   adsb    — adsb.lol hubs only (no OpenSky credits / no cloud-IP issues)
# FLIGHT_UPSTREAM=auto

# How often the backend polls when clients are active (ms).
# Default 120000 for OpenSky (2 min). ADS-B mode defaults to 60s.
# World OpenSky /states/all costs **4 credits** — keep intervals ≥2 min on free tier.
# Transient fetch errors retry in seconds; only 429s use a long backoff.
# FLIGHT_POLL_INTERVAL_MS=120000

# When adsbdb has no route, try OpenSky /flights/aircraft estimated airports
# for airline-like callsigns (~1 credit each). Set to 0 to disable.
# FLIGHT_ROUTE_OPENSKY_FALLBACK=1

# Synthetic traffic — only when you opt in:
#   npm run dev:mock
# FLIGHT_BACKEND_MOCK=1

# ---------------------------------------------------------------------------
# Flight data source (only used when VITE_USE_BACKEND=0)
# ---------------------------------------------------------------------------
# Default (unset): keyless airplanes.live — works with no account, tiles
# coverage across the view.
#
# Set to "opensky" for full bounding-box coverage of the whole visible area
# (recommended for the best look). Requires the OpenSky credentials below.
VITE_FLIGHT_SOURCE=opensky

# ---------------------------------------------------------------------------
# OpenSky authentication (used by the shared backend on `npm run dev`)
# ---------------------------------------------------------------------------
# Credit tiers (states bucket, refills daily):
#   anonymous ~400 | free account ~4,000 | active ADS-B feeder ~8,000
# World poll = 4 credits. At 2 min interval ≈ 2.9k/day (fits free tier).
#
# 1. Create a free account at https://opensky-network.org
# 2. Account -> create an API client (OAuth2 client credentials).
# 3. Paste the client id + secret below and restart `npm run dev`.
#
# Read ONLY by the Node backend / Vite dev server — never sent to the browser.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
