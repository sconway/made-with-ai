{
  "name": "Flight Globe",
  "short_name": "Flight Globe",
  "description": "Watch live flights on a 3D globe. Track callsigns, routes, altitude, and airports in real time.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
